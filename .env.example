# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# SerpAPI is REQUIRED for Google Boolean Search (free: 100 searches/month)
# Sign up at https://serpapi.com and paste your key below.
JOBSEARCH_SERPAPI_KEY=your_serpapi_key_here

# Optional: Adzuna job board API (free: 250 calls/month)
# Sign up at https://developer.adzuna.com
JOBSEARCH_ADZUNA_APP_ID=
JOBSEARCH_ADZUNA_API_KEY=

# Optional: Firecrawl for advanced page scraping (free: 500 credits/month)
# Sign up at https://firecrawl.dev
JOBSEARCH_FIRECRAWL_API_KEY=
